{
  "name": "@ramarivera/coding-buddy",
  "version": "0.9.3",
  "description": "Persistent coding companion for Claude Code, Pi, and Oh My Pi",
  "type": "module",
  "omp": {
    "extensions": [
      "./adapters/omp/index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./adapters/pi/index.ts"
    ]
  },
  "bin": {
    "coding-buddy": "cli/index.ts"
  },
  "scripts": {
    "server": "bun run server/index.ts",
    "pick": "bun run cli/pick.ts",
    "hunt": "bun run cli/hunt.ts",
    "install-buddy": "bun run cli/install.ts",
    "show": "bun run cli/show.ts",
    "doctor": "bun run cli/doctor.ts",
    "test-statusline": "bun run cli/test-statusline.ts",
    "backup": "bun run cli/backup.ts",
    "settings": "bun run cli/settings.ts",
    "disable": "bun run cli/disable.ts",
    "enable": "bun run cli/install.ts",
    "upgrade": "bun run cli/upgrade.ts",
    "uninstall": "bun run cli/uninstall.ts",
    "help": "bun run cli/index.ts help",
    "buddy-shell": "npx tsx cli/buddy-shell.ts",
    "tui": "bun run cli/tui.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "gen:emoji-widths": "bun run scripts/gen-emoji-widths.ts",
    "sync-version": "bun run scripts/sync-version.ts",
    "version": "bun run sync-version && git add .claude-plugin",
    "ci:statusline": "bash scripts/ci/check-statusline.sh",
    "ci:vhs:render": "bash scripts/ci/render-vhs-goldens.sh",
    "ci:vhs:update": "bash scripts/ci/render-vhs-goldens.sh --update",
    "ci:vhs:check": "bash scripts/ci/check-vhs-goldens.sh"
  },
  "files": [
    "core/",
    "adapters/",
    "server/",
    "cli/",
    "skills/",
    "hooks/",
    "statusline/",
    "scripts/",
    ".claude-plugin/",
    "!**/*.test.ts"
  ],
  "keywords": [
    "coding-buddy",
    "claude-code",
    "pi",
    "oh-my-pi",
    "omp",
    "buddy",
    "companion",
    "mcp",
    "terminal-pet",
    "tamagotchi",
    "pi-package",
    "omp-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramarivera/coding-buddy.git"
  },
  "homepage": "https://github.com/ramarivera/coding-buddy#readme",
  "license": "MIT",
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "ink": "^7.0.0",
    "pino": "^10.3.1",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "0.66.1",
    "@oh-my-pi/pi-agent-core": "17.0.9",
    "@oh-my-pi/pi-ai": "17.0.9",
    "@oh-my-pi/pi-coding-agent": "17.0.9",
    "@oh-my-pi/pi-catalog": "17.0.9",
    "@types/react": "^19.2.14",
    "bun-types": "^1.3.11",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "trustedDependencies": [
    "@homebridge/node-pty-prebuilt-multiarch"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "0.66.1",
    "@oh-my-pi/pi-agent-core": "17.0.9",
    "@oh-my-pi/pi-ai": "17.0.9",
    "@oh-my-pi/pi-coding-agent": "17.0.9"
  },
  "peerDependenciesMeta": {
    "@mariozechner/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-agent-core": {
      "optional": true
    },
    "@oh-my-pi/pi-ai": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  }
}
